import torch
import torch.nn as nn
import torch.distributions as dist
from torch.nn.functional import softplus
import matplotlib.pyplot as plt

# Set random seed for reproducibility
torch.manual_seed(42)

class ProbabilisticPCA(nn.Module):
    def __init__(self, data_dim, latent_dim):
        super(ProbabilisticPCA, self).__init__()
        self.data_dim = data_dim
        self.latent_dim = latent_dim

        # Learnable parameters
        self.W_mean = nn.Parameter(torch.randn(data_dim, latent_dim))
        self.W_log_scale = nn.Parameter(torch.randn(data_dim, latent_dim))
        self.Z_mean = nn.Parameter(torch.randn(latent_dim))
        self.Z_log_scale = nn.Parameter(torch.randn(latent_dim))

    def forward(self):
        w_dist = dist.Normal(self.W_mean, softplus(self.W_log_scale))
        z_dist = dist.Normal(self.Z_mean, softplus(self.Z_log_scale))

        w = w_dist.sample()
        z = z_dist.sample()

        return w, z

# Generate random 7D data
num_samples = 100
data_dim = 7
latent_dim = 2
stddv_datapoints = 0.5

# Set random_data to require gradients
random_data = torch.randn(num_samples, data_dim, requires_grad=True)

# Create and train Probabilistic PCA model
ppca_model = ProbabilisticPCA(data_dim, latent_dim)
optimizer = torch.optim.Adam(ppca_model.parameters(), lr=0.01)

for epoch in range(1000):
    optimizer.zero_grad()
    w, z = ppca_model()
    x_dist = dist.Normal(torch.matmul(random_data, w @ z), stddv_datapoints)
    x_sample = x_dist.sample()
    loss = -x_dist.log_prob(x_sample).sum()
    loss.backward()
    optimizer.step()

# Get the learned parameters
learned_w, learned_z = ppca_model()

# Apply the learned mapping to the data
mapped_data = random_data @ learned_w @ learned_z

# Reshape mapped_data to have two dimensions
mapped_data = mapped_data.reshape(-1, 2)

# Plot the original and mapped data
plt.scatter(random_data[:, 0].detach().numpy(), random_data[:, 1].detach().numpy(), label='Original Data', alpha=0.5)
plt.scatter(mapped_data[:, 0].detach().numpy(), mapped_data[:, 1].detach().numpy(), label='Mapped Data', alpha=0.5)
plt.title('Probabilistic PCA Mapping from 7D to 2D')
plt.legend()
plt.show()
